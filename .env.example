# Create a .env file from this template. Never commit your real key.
RAILRADAR_API_KEY=rr_live_your_key_here

# The values below are conservative defaults for the free tier. Increase only if
# your provider plan supports the added historical requests.
HISTORY_DAYS=7
MAX_TRAINS_PER_SEARCH=20
# Auto-score every result when a search returns this many trains or fewer.
AUTO_ANALYSE_MAX=3

# Optional. Default is .cache/provider.json
# CACHE_FILE=.cache/provider.json

# The supplied RailRadar plan is capped at 10 upstream requests per minute.
PROVIDER_REQUESTS_PER_MINUTE=10
PORT=8787
